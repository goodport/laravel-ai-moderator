{
    "name": "goodport/laravel-ai-moderator",
    "description": "Declarative AI moderation checks for Laravel applications.",
    "type": "library",
    "homepage": "https://github.com/goodport/laravel-ai-moderator",
    "license": "MIT",
    "authors": [
        {
            "name": "goodport"
        }
    ],
    "keywords": [
        "ai",
        "laravel",
        "llm",
        "moderation"
    ],
    "require": {
        "ext-mbstring": "*",
        "goodport/laravel-ai-journal": "^1.1",
        "laravel/ai": "^1.4",
        "laravel/framework": "^12.62|^13.0",
        "php": "^8.3"
    },
    "require-dev": {
        "laravel/pint": "^1.26",
        "orchestra/testbench": "^10.6|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Goodport\\AiModerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goodport\\AiModerator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Goodport\\AiModerator\\AiModeratorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
